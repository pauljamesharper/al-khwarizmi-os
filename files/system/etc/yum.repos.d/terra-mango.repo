# Terra, limited to mango and its wallpaper daemon; shipped by al-khwarizmi-os.
[terra-mango]
name=Terra $releasever (mangowm, awww)
baseurl=https://repos.fyralabs.com/terra$releasever
includepkgs=mangowm awww
type=rpm
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
enabled=1

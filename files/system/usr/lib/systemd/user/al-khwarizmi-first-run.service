# Runs once at first login: clones the vendored dotfiles into $HOME and runs
# the per-user steps of their aurora/setup.sh in a terminal window. See
# /usr/bin/al-khwarizmi-first-run for the logic and the stamp file that makes
# this a one-time thing. Enabled for every user by the recipe's systemd module.
#
# WantedBy=graphical-session.target, not default.target: this opens a GUI
# terminal, so it needs the Wayland session. mango reaches that target once
# it is up (via mango-session.target).

[Unit]
Description=al-khwarizmi-os first-run setup (dotfiles)
ConditionPathExists=/usr/share/al-khwarizmi-os/dotfiles
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/al-khwarizmi-first-run
RemainAfterExit=yes
# setup.sh takes a while (Homebrew, mise, theme builds); don't time it out.
TimeoutStartSec=infinity

[Install]
WantedBy=graphical-session.target

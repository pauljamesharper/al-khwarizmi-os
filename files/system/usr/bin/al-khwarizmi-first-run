#!/usr/bin/env bash

# First-login setup: clones the vendored dotfiles repo into $HOME and runs
# its (interactive) install.sh in a visible terminal. Driven by
# al-khwarizmi-first-run.service (systemd --user, WantedBy=graphical-session
# .target -- see that unit for why that target and not default.target).
#
# Deliberately NOT `set -e`: a failed check here (no vendored copy, dotfiles
# already cloned, alacritty missing) should fall through to a clean exit, not
# abort the whole script and leave the stamp file unwritten so it retries
# forever.
set -uo pipefail

STAMP="$HOME/.local/state/al-khwarizmi-os/first-run-done"
VENDORED=/usr/share/al-khwarizmi-os/dotfiles
DOTFILES_REPO=https://codeberg.org/gluesniffmonkey/dotfiles.git

# Already ran once -- nothing to do. install.sh itself is idempotent, so
# re-running it by hand any time (`~/dotfiles/install.sh`) is always safe;
# this stamp only controls the automatic one-shot terminal popup.
[[ -e $STAMP ]] && exit 0

# Nothing vendored (e.g. this image variant doesn't ship dotfiles) -- quietly
# skip rather than error. Desktop still works fine without the personal layer.
[[ -d $VENDORED ]] || exit 0

mkdir -p "$(dirname "$STAMP")"

if [[ ! -d "$HOME/dotfiles" ]]; then
    # Clone from the local vendored copy (fast, no network needed for this
    # step), then repoint origin at the real remote so it's a normal clone
    # from the user's point of view -- `git pull`/`push` just work.
    git clone "$VENDORED" "$HOME/dotfiles"
    git -C "$HOME/dotfiles" remote set-url origin "$DOTFILES_REPO"
    git -C "$HOME/dotfiles" fetch origin 2>/dev/null || true
fi

if command -v alacritty >/dev/null 2>&1; then
    # install.sh's own "Prerequisites" step (README) is normally done by hand
    # before cloning: Homebrew backs stow + the CLI set, and install.sh
    # hard-requires stow (`have stow || die`). Do it here instead so the
    # automatic first-run actually gets that far unattended.
    alacritty --title "al-khwarizmi-os setup" -e bash -lc '
        if ! command -v brew >/dev/null 2>&1; then
            echo "Installing Homebrew (backs stow + the CLI set)..."
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        fi
        command -v stow >/dev/null 2>&1 || brew install stow

        cd "$HOME/dotfiles" || exit 1
        ./install.sh
        echo
        read -n1 -rsp "Press any key to close this window..."
    '
fi

touch "$STAMP"
